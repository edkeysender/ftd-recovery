# FTD Recovery — self-update configuration
# Installed at /etc/ftd-recovery/update.conf, sourced by recovery-update
# (bash syntax). Root-only (0600): contains the VPN preshared key and,
# optionally, a GitLab deploy token.

# Internal GitLab project that hosts FTD Recovery.
GITLAB_URL="http://gitlab.ftdinternal.aero/ftd-supp/ftd_recovery"

# Branch or tag to update to.
REPO_REF="main"

# ── VPN (L2TP/IPsec) — used only when GitLab is not reachable directly ──────
# Devices inside the company network skip everything in this section.
# The update dialog asks the operator for their VPN username/password; those
# are kept in RAM only while the tunnel authenticates and never written to
# disk. Only GitLab's address is routed through the tunnel (split tunnel) —
# PXE/NFS service on the local network is not interrupted.

# Public address of the company VPN gateway.
VPN_GATEWAY=""

# IPsec preshared key.
VPN_PSK=""

# GitLab's IP address inside the company network. Required for field
# devices: it is the ONLY address routed through the tunnel, and the
# hostname above is pinned to it while the tunnel is up.
GITLAB_IP=""

# Seconds to wait for the PPP link to come up.
VPN_TIMEOUT=90

# IKE/ESP proposal lists (strongSwan 6 swanctl syntax) — override only if the
# gateway rejects the defaults. 'default' appends strongSwan's built-ins for
# compatibility. Crypto is provided by the openssl plugin.
#VPN_IKE="aes256-sha256-modp2048,aes256-sha1-modp1024,aes128-sha1-modp1024,3des-sha1-modp1024,default"
#VPN_ESP="aes256-sha256,aes256-sha1,aes128-sha1,3des-sha1,default"

# ── Repository access (optional) ─────────────────────────────────────────────
# Read-only GitLab deploy token (project Settings → Repository → Deploy
# tokens, scope read_repository) used for the git clone itself. Leave empty
# if the project allows anonymous read.
GITLAB_TOKEN_USER=""
GITLAB_TOKEN=""
