#!/usr/bin/env bash
# Write/remove a per-MAC GRUB config file for the recovery interface.
# Filename: ${DIR}/grub.cfg-<mac-with-colons> (matches ${net_default_mac}).

set -euo pipefail

DIR=/srv/tftp/debian-installer/amd64/grub

# The server IP is detected when a job is armed, never baked in at install:
# the Pi's DHCP lease can change and a stale address strands PXE clients.
# Prefer the interface dnsmasq serves PXE on; fall back to the default route.
server_ip() {
  local iface addr
  iface=$(sed -n 's/^interface=//p' /etc/dnsmasq.d/clonezilla-pxe.conf 2>/dev/null | head -1)
  [[ -z "$iface" ]] && iface=$(ip route show default 2>/dev/null | awk '/default/ {print $5; exit}')
  addr=$(ip -4 -o addr show dev "$iface" scope global 2>/dev/null \
           | awk '{print $4}' | cut -d/ -f1 | head -1)
  echo "$addr"
}

if [[ $# -lt 2 ]]; then
  echo "usage: $(basename "$0") {write <mac> <mode> [image]|remove <mac>}" >&2
  exit 2
fi

action=$1
mac_in=$2

if [[ ! "$mac_in" =~ ^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$ ]]; then
  echo "invalid MAC: $mac_in" >&2
  exit 1
fi
mac=$(echo "$mac_in" | tr "[:upper:]" "[:lower:]")
target="${DIR}/grub.cfg-${mac}"

case "$action" in
  write)
    if [[ $# -lt 3 ]]; then
      echo "write requires <mac> <mode> [image]" >&2; exit 2
    fi
    mode=$3
    image=${4:-}
    case "$mode" in
      backup)   script=ocs-backup.sh;  label="BACKUP (auto-armed)" ;;
      recovery) script=ocs-restore.sh; label="RESTORE (auto-armed)" ;;
      *) echo "unknown mode: $mode" >&2; exit 1 ;;
    esac
    # Validate image name (alnum + . _ -)
    if [[ -n "$image" && ! "$image" =~ ^[A-Za-z0-9._-]+$ ]]; then
      echo "invalid image name: $image" >&2; exit 1
    fi
    image_arg=""
    [[ -n "$image" ]] && image_arg="ocs_image=${image} "

    SERVER_IP=$(server_ip)
    if [[ -z "$SERVER_IP" ]]; then
      echo "cannot determine server IP (no address on PXE interface?)" >&2
      exit 1
    fi

    tmp=$(mktemp "${target}.XXXXXX")
    chmod 644 "$tmp"
    cat > "$tmp" <<EOF
set timeout=0
set default=0

menuentry "$label" {
    linux (tftp)/clonezilla/vmlinuz boot=live locales=en_US.UTF-8 keyboard-layouts=us union=overlay username=user config components noswap edd=on enforcing=0 noeject vga=normal fetch=http://${SERVER_IP}:8080/clonezilla/filesystem.squashfs ${image_arg}ocs_prerun1="mount -t nfs ${SERVER_IP}:/srv/clonezilla-images /home/partimag" ocs_prerun2="wget -q http://${SERVER_IP}:8080/${script} -O /tmp/r.sh" ocs_prerun3="chmod +x /tmp/r.sh" ocs_live_run="/tmp/r.sh" ocs_live_batch=no
    initrd (tftp)/clonezilla/initrd.img
}
EOF
    mv "$tmp" "$target"
    ;;
  remove)
    rm -f "$target"
    ;;
  *)
    echo "unknown action: $action" >&2; exit 2 ;;
esac
